# Public build-time settings (exposed to the browser – NO secrets here).
# Copy to .env.local for local development; set as GitHub/Cloudflare build variables in production.

# Contact address shown on the site. Personal values belong in .env.local (gitignored), not here.
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional maker credit shown in the footer/about section. Empty = no personal details.
NEXT_PUBLIC_FOUNDER_NAME=
NEXT_PUBLIC_FOUNDER_BIO=

# mock (default) = simulated checkout/webhooks/e-mail, live = real hosted checkout link below.
NEXT_PUBLIC_BILLING_MODE=mock

# Hosted checkout link from the payment provider (test-mode link first). Empty = "Anmäl intresse" instead of buy.
NEXT_PUBLIC_CHECKOUT_URL=

# Displayed price. MUST match the price configured in the payment provider, e.g. "590 kr inkl. moms".
NEXT_PUBLIC_PRICE_LABEL=

# Name of the payment provider shown in the purchase notes, e.g. "Polar".
NEXT_PUBLIC_PAYMENT_PROVIDER=

# Set to "true" only after you have reviewed and approved the privacy notice and terms.
NEXT_PUBLIC_POLICIES_APPROVED=

# Base path when hosted under a sub-path (GitHub Pages project site). Empty for a root domain.
NEXT_PUBLIC_BASE_PATH=
